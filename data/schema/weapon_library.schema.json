{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/weapon_library.schema.json",
  "title": "Weapon Library",
  "description": "武装库：按类别分组的占位武装定义，供形态通过 weapon_id 引用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "balance_patch", "weapons"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "library": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "weapons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name_key", "category", "slot_types", "damage_class", "range_class", "asset_binding"],
        "properties": {
          "id": { "type": "string", "pattern": "^weapon\\.[a-z0-9_]+$" },
          "display_name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
          "category": { "enum": ["beam", "ballistic", "melee", "special"] },
          "slot_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["main", "sub", "melee", "shield", "special"] }
          },
          "damage_class": { "enum": ["light", "medium", "heavy", "siege"] },
          "range_class": { "enum": ["melee", "short", "mid", "long"] },
          "magazine": { "type": "integer", "minimum": 1, "maximum": 999 },
          "total_ammo": { "type": "integer", "minimum": 1, "maximum": 9999 },
          "reload_sec": { "type": "number", "minimum": 0.1, "maximum": 15 },
          "melee_combo": { "type": "integer", "minimum": 1, "maximum": 8 },
          "lock_count": { "type": "integer", "minimum": 1, "maximum": 16 },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "chargeable",
                "multi_lock",
                "predictive",
                "sniper_mode",
                "anti_armor",
                "phase_shift_piercing",
                "returning",
                "grapple",
                "guard",
                "directional_guard",
                "ma_only",
                "supply_refill"
              ]
            }
          },
          "notes": { "type": "string" },
          "asset_binding": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placeholder"],
            "properties": {
              "model_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
              "vfx_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
              "sfx_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
              "placeholder": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
