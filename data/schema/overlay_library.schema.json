{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/overlay_library.schema.json",
  "title": "Mode Overlay Library",
  "description": "装甲 / 模式叠加层：不新建形态，仅在形态之上覆写参数与规则。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "balance_patch", "overlays"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "overlays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name_key", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^overlay\\.[a-z0-9_]+$" },
          "display_name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
          "kind": { "enum": ["armor", "awakening", "stance", "stealth"] },
          "activation": { "enum": ["always_on", "manual", "conditional"] },
          "duration_sec": { "type": "number", "minimum": 0, "maximum": 120 },
          "cooldown_sec": { "type": "number", "minimum": 0, "maximum": 300 },
          "requires_trait": { "type": "string", "pattern": "^trait\\.[a-z0-9_]+$" },
          "stat_modifiers": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hp": { "type": "number", "minimum": -1, "maximum": 2 },
              "en": { "type": "number", "minimum": -1, "maximum": 2 },
              "mobility": { "type": "number", "minimum": -1, "maximum": 1 },
              "defense": { "type": "number", "minimum": -1, "maximum": 1 },
              "firepower": { "type": "number", "minimum": -1, "maximum": 1 },
              "boost_recovery": { "type": "number", "minimum": -1, "maximum": 1 },
              "lock_range": { "type": "number", "minimum": -1, "maximum": 1 }
            }
          },
          "rules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "ballistic_immunity_pool",
                "directional_damage_reduction",
                "beam_reflection",
                "lock_on_penalty_to_enemy",
                "movement_locked_while_firing",
                "downed_state_visual_only",
                "afterimage_on_dash"
              ]
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
