{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/form_set.schema.json",
  "title": "Form Set",
  "description": "单个底盘拥有的全部形态（换装 / 变形 / 模式叠加宿主）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "parent_chassis", "forms"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "parent_chassis": { "type": "string", "pattern": "^chassis\\.[a-z0-9_]+$" },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/form" }
    }
  },
  "$defs": {
    "loc_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
    "form_id": { "type": "string", "pattern": "^form\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "stat_modifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hp": { "type": "number", "minimum": -1, "maximum": 2 },
        "en": { "type": "number", "minimum": -1, "maximum": 2 },
        "mobility": { "type": "number", "minimum": -1, "maximum": 1 },
        "defense": { "type": "number", "minimum": -1, "maximum": 1 },
        "firepower": { "type": "number", "minimum": -1, "maximum": 1 },
        "boost_recovery": { "type": "number", "minimum": -1, "maximum": 1 },
        "lock_range": { "type": "number", "minimum": -1, "maximum": 1 }
      }
    },
    "form": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name_key", "type", "weapons", "asset_binding"],
      "properties": {
        "id": { "$ref": "#/$defs/form_id" },
        "display_name_key": { "$ref": "#/$defs/loc_key" },
        "type": { "enum": ["equipment_form", "transform_form", "base_form"] },
        "size_class_override": { "enum": ["small", "medium", "large", "huge"] },
        "stat_modifiers": { "$ref": "#/$defs/stat_modifiers" },
        "weapons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "weapon_id"],
            "properties": {
              "slot": { "enum": ["main", "sub", "melee", "shield", "special"] },
              "weapon_id": { "type": "string", "pattern": "^weapon\\.[a-z0-9_]+$" }
            }
          }
        },
        "abilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ability\\.(sp|passive|additional)\\.[a-z0-9_]+$" }
        },
        "transform_graph": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "trigger", "duration_sec"],
            "properties": {
              "to": { "$ref": "#/$defs/form_id" },
              "trigger": { "enum": ["manual", "auto_speed", "auto_altitude", "purge"] },
              "duration_sec": { "type": "number", "minimum": 0, "maximum": 10 },
              "one_way": { "type": "boolean" },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min_altitude_m": { "type": "number", "minimum": 0 },
                  "require_states": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "enum": ["ground", "air", "space"] }
                  },
                  "forbid_states": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": { "enum": ["grappled", "downed", "overheated"] }
                  },
                  "min_en_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "mode_overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["overlay_id"],
            "properties": {
              "overlay_id": { "type": "string", "pattern": "^overlay\\.[a-z0-9_]+$" },
              "requires": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pilot_trait": { "type": "string", "pattern": "^trait\\.[a-z0-9_]+$" },
                  "hp_ratio_below": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        },
        "asset_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placeholder"],
          "properties": {
            "model_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
            "silhouette_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
            "placeholder": { "type": "boolean" }
          }
        }
      }
    }
  }
}
