{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/units_manifest.schema.json",
  "title": "Units Manifest",
  "description": "顶层清单：声明阵营、库文件与底盘索引。所有 ref 为相对 data/ 的 POSIX 路径。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "balance_patch", "factions", "libraries", "chassis_index"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "milestone": { "type": "string", "pattern": "^M\\d$" },
    "notes": { "type": "string" },
    "factions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name_key"],
        "properties": {
          "id": { "type": "string", "pattern": "^faction\\.[a-z0-9_]+$" },
          "name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" }
        }
      }
    },
    "libraries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weapons", "abilities", "overlays", "pilots", "locales"],
      "properties": {
        "weapons": { "$ref": "#/$defs/ref_list" },
        "abilities": { "$ref": "#/$defs/ref_list" },
        "overlays": { "$ref": "#/$defs/ref_list" },
        "pilots": { "$ref": "#/$defs/ref_list" },
        "locales": { "$ref": "#/$defs/ref_list" }
      }
    },
    "chassis_index": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref"],
        "properties": {
          "ref": { "$ref": "#/$defs/data_ref" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "data_ref": {
      "type": "string",
      "pattern": "^[a-z0-9_][a-z0-9_./-]*\\.yaml$"
    },
    "ref_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/data_ref" }
    }
  }
}
