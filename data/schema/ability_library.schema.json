{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/ability_library.schema.json",
  "title": "Ability Library",
  "description": "SP 攻击 / 被动 / アディショナル 技能库。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "balance_patch", "abilities"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "abilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name_key", "type", "owner_scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^ability\\.(sp|passive|additional)\\.[a-z0-9_]+$" },
          "display_name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
          "type": { "enum": ["sp_attack", "passive", "additional"] },
          "owner_scope": { "enum": ["chassis", "pilot", "shared"] },
          "sp_cost": { "type": "number", "minimum": 0, "maximum": 6 },
          "trigger": { "enum": ["manual", "hp_threshold", "always"] },
          "hp_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
          "combination_partner_ok": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
