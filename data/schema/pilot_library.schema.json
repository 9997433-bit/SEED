{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/pilot_library.schema.json",
  "title": "Pilot Library",
  "description": "驾驶员与特质库。M0 仅收录原创驾驶员与通用模板，不收录任何官方角色。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "balance_patch", "traits", "pilots"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "traits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name_key"],
        "properties": {
          "id": { "type": "string", "pattern": "^trait\\.[a-z0-9_]+$" },
          "display_name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
          "notes": { "type": "string" }
        }
      }
    },
    "pilots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name_key", "kind", "origin", "growth_template"],
        "properties": {
          "id": { "type": "string", "pattern": "^pilot\\.[a-z0-9_]+$" },
          "display_name_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
          "kind": { "enum": ["player_avatar", "partner", "generic", "guest"] },
          "origin": { "const": "original" },
          "growth_template": { "type": "string", "pattern": "^growth\\.[a-z0-9_]+$" },
          "traits": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^trait\\.[a-z0-9_]+$" }
          },
          "abilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ability\\.(sp|passive|additional)\\.[a-z0-9_]+$" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
