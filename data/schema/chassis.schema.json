{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seed-remake:data/schema/chassis.schema.json",
  "title": "Chassis",
  "description": "机体底盘：不可拆分的素体身份，决定基础数值、可接入的形态族与换装策略。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "balance_patch",
    "id",
    "model_number",
    "display_name_key",
    "description_key",
    "series",
    "era",
    "faction_production",
    "faction_playable",
    "power_budget",
    "base_stats",
    "forms",
    "forms_ref",
    "default_form",
    "asset_binding"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "balance_patch": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "id": { "type": "string", "pattern": "^chassis\\.[a-z0-9_]+$" },
    "model_number": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
    "display_name_key": { "$ref": "#/$defs/loc_key" },
    "description_key": { "$ref": "#/$defs/loc_key" },
    "series": { "enum": ["seed", "seed_destiny", "astray"] },
    "era": { "enum": ["ce71", "ce73"] },
    "faction_production": { "$ref": "#/$defs/faction_id" },
    "faction_playable": { "$ref": "#/$defs/faction_id" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "g_project",
          "swap_pack",
          "transform",
          "mass_produced",
          "heavy",
          "support",
          "melee",
          "sniper",
          "boss",
          "phase_shift",
          "seed_mode",
          "prototype",
          "core_splitter"
        ]
      }
    },
    "power_budget": { "type": "integer", "minimum": 600, "maximum": 1600 },
    "base_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hp", "en", "mobility", "defense", "size_class"],
      "properties": {
        "hp": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "en": { "type": "integer", "minimum": 10, "maximum": 500 },
        "mobility": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "defense": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "size_class": { "enum": ["small", "medium", "large", "huge"] }
      }
    },
    "forms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/form_id" }
    },
    "forms_ref": { "type": "string", "pattern": "^[a-z0-9_][a-z0-9_./-]*\\.yaml$" },
    "default_form": { "$ref": "#/$defs/form_id" },
    "form_switch_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["none", "mid_battle_swap", "pre_sortie_only", "transform_only", "purge_one_way"] },
        "cooldown_sec": { "type": "number", "minimum": 0, "maximum": 60 },
        "inherit_hp_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "inherit_en_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowed_states": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["ground", "air", "space"] }
        }
      }
    },
    "compatible_pilots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^pilot\\.[a-z0-9_]+$" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 4 }
    },
    "asset_binding": { "$ref": "#/$defs/asset_binding" }
  },
  "$defs": {
    "loc_key": { "type": "string", "pattern": "^loc\\.[a-z0-9_.]+$" },
    "faction_id": { "type": "string", "pattern": "^faction\\.[a-z0-9_]+$" },
    "form_id": { "type": "string", "pattern": "^form\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
    "asset_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placeholder"],
      "properties": {
        "model_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "skeleton_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "icon_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
        "placeholder": { "type": "boolean" }
      }
    }
  }
}
